FROM localhost/ubuntu:focal-minimal-20250625

ARG DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ROS_DISTRO=foxy

RUN set -eux; \
    echo 'Etc/UTC' > /etc/timezone; \
    ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime; \
    apt-get update; \
    apt-get install -q -y --no-install-recommends \
      ca-certificates \
      curl \
      dirmngr \
      gnupg2 \
      tzdata; \
    rm -rf /var/lib/apt/lists/*

# This key and snapshot source match the OSRF Foxy final ros-core recipe.
RUN set -eux; \
    key='4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA'; \
    export GNUPGHOME="$(mktemp -d)"; \
    gpg --batch --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys "$key"; \
    mkdir -p /usr/share/keyrings; \
    gpg --batch --export "$key" > /usr/share/keyrings/ros2-snapshots-archive-keyring.gpg; \
    gpgconf --kill all; \
    rm -rf "$GNUPGHOME"; \
    echo 'deb [ signed-by=/usr/share/keyrings/ros2-snapshots-archive-keyring.gpg ] http://snapshots.ros.org/foxy/final/ubuntu focal main' > /etc/apt/sources.list.d/ros2-snapshots.list

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ros-foxy-ros-core=0.9.2-1* \
      ros-foxy-ros-base=0.9.2-1* \
      build-essential \
      cmake \
      git \
      iproute2 \
      libeigen3-dev \
      libpcl-dev \
      netcat-openbsd \
      python3-colcon-common-extensions \
      python3-pip \
      python3-pytest \
      python3-rosdep \
      python3-vcstool \
      ros-foxy-ament-cmake-gtest \
      ros-foxy-cv-bridge \
      ros-foxy-launch-testing-ament-cmake \
      ros-foxy-message-filters \
      ros-foxy-pcl-conversions \
      ros-foxy-tf2-geometry-msgs \
      ros-foxy-tf2-ros; \
    rm -rf /var/lib/apt/lists/*

COPY ros_entrypoint.sh /ros_entrypoint.sh
RUN chmod 0755 /ros_entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]

